2C%20then%20remove%20and%20discard%20the%20seeds.%20Dice%20tomato%20into%201/4-inch%20pieces.%22%2C%22index%22%3A8%7D%2C%7B%22step%22%3A%22Roughly%20chop%20the%20cilantro%20leaves.%22%2C%22index%22%3A9%7D%2C%7B%22step%22%3A%22Top%20each%20pizza%20with%20equal%20amounts%20of%20tomato%20and%20cilantro%2C%20then%20drizzle%20with%20reserved%20barbecue%20sauce.%20Slice%20and%20serve.%20Refrigerate%20leftovers%20in%20an%20airtight%20container%20for%20up%20to%202%20days.%20Reheat%20in%20the%20oven%20at%20350%B0F%20for%205-7%20minutes.%22%2C%22index%22%3A10%7D%5D%2C%22nativeAdInfo%22%3Anull%2C%22promoted%22%3Afalse%2C%22tags%22%3A%5B%7B%22text%22%3A%22Main%20Dishes%22%2C%22description%22%3A%22Course%3A%20Main%20Dishes%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Sugar%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Sugar%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Baking%22%2C%22description%22%3A%22Technique%3A%20Baking%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Sodium%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Sodium%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Saturated%20Fat%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Saturated%20Fat%22%2C%22hidden%22%3Atrue%7D%2C%7B%22text%22%3A%22Low%20Fat%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Fat%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Carb%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Carb%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Calorie%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Calorie%22%2C%22hidden%22%3Afalse%7D%5D%2C%22ingredientLines%22%3A%7B%22imperial%22%3A%5B%7B%22ingredient%22%3A%22naan%22%2C%22ingredientId%22%3A%224112436f-3f81-4019-97ca-e886c8fd9641%22%2C%22checked%22%3Afalse%2C%22category%22%3A%22bakery%22%2C%22categoryId%22%3A%22a18ef82c-56c9-4ace-9283-cfe9dcda1731%22%2C%22remainder%22%3A%22%22%2C%22amount%22%3A4%2C%22abbreviation%22%3A%22piece%22%2C%22pluralAbbreviation%22%3A%22pieces%22%2C%22decimal%22%3Afalse%2C%22