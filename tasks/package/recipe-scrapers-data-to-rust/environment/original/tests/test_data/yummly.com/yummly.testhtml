D%2C%22units%22%3A%22IMPERIAL%22%2C%22servings%22%3A4%2C%22displayServings%22%3A4%2C%22image%22%3A%22https%3A//lh3.googleusercontent.com/ngYJ2DBsxPhw4hq3jt2SxVMvkxrOEMI5aACJxVKtDewwFGDwdv9MSswp8C1aK69S_ARnea5_yhM3DyIwaWLiqi4%22%2C%22imageHeight%22%3A1080%2C%22imageWidth%22%3A1920%2C%22showInlinePrepSteps%22%3Atrue%2C%22alternateExternalUrls%22%3A%7B%7D%2C%22prepStepCount%22%3A11%2C%22prepSteps%22%3A%5B%7B%22step%22%3A%22Preheat%20oven%20to%20425%B0F.%22%2C%22index%22%3A0%7D%2C%7B%22step%22%3A%22Line%20a%20baking%20sheet%20with%20parchment%20paper.%20%22%2C%22index%22%3A1%7D%2C%7B%22step%22%3A%22Arrange%20the%20naan%20on%20the%20baking%20sheet.%20Drizzle%20an%20equal%20amount%20of%20olive%20oil%20over%20the%20surface%20of%20each%20piece%20and%20spread%20with%20the%20back%20of%20a%20spoon.%22%2C%22index%22%3A2%7D%2C%7B%22step%22%3A%22Spread%201%201/2%20tablespoons%20of%20barbecue%20sauce%20evenly%20on%20the%20center%20of%20each%20naan%20piece%2C%20leaving%20a%201/2-inch%20border%20around%20the%20sauce.%20Reserve%20remaining%20barbecue%20sauce%20for%20serving.%22%2C%22index%22%3A3%7D%2C%7B%22step%22%3A%22Cut%20the%20onion%20into%201/8-inch-thick%20slices.%22%2C%22index%22%3A4%7D%2C%7B%22step%22%3A%22Arrange%20an%20equal%20amount%20of%20onion%20slices%2C%20shredded%20chicken%2C%20and%20the%20shredded%20cheeses%20onto%20each%20naan%20piece.%22%2C%22index%22%3A5%7D%2C%7B%22step%22%3A%22Bake%20the%20pizzas%20on%20lower-middle%20rack%20of%20oven%20until%20naan%20is%20crisp%20and%20the%20cheese%20is%20bubbly%20and%20golden%2C%2013-15%20minutes.%22%2C%22index%22%3A6%7D%2C%7B%22step%22%3A%22Check%20to%20see%20that%20pizzas%20are%20done.%20Remove%20from%20oven%20or%20add%20time%20as%20needed.%22%2C%22index%22%3A7%7D%2C%7B%22step%22%3A%22Halve%20the%20tomato%2C%20then%20remove%20and%20discard%20the%20seeds.%20Dice%20tomato%20into%201/4-inch%20pieces.%22%2C%22index%22%3A8%7D%2C%7B%22step%22%3A%22Roughly%20chop%20the%20cilantro%20leaves.%22%2C%22index%22%3A9%7D%2C%7B%22step%22%3A%22Top%20each%20pizza%20with%20equal%20amounts%20of%20tomato%20and%20cilantro%2C%20then%20drizzle%20with%20reserved%20barbecue%20sauce.%20Slice%20and%20serve.%20Refrigerate%20leftovers%20in%20an%20airtight%20container%20for%20up%20to%202%20days.%20Reheat%20in%20the%20oven%20at%20350%B0F%20for%205-7%20minutes.%22%2C%22index%22%3A10%7D%5D%2C%22nativeAdInfo%22%3Anull%2C%22promoted%22%3Afalse%2C%22tags%22%3A%5B%7B%22text%22%3A%22Main%20Dishes%22%2C%22description%22%3A%22Course%3A%20Main%20Dishes%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Sugar%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Sugar%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Baking%22%2C%22description%22%3A%22Technique%3A%20Baking%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Sodium%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Sodium%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Saturated%20Fat%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Saturated%20Fat%22%2C%22hidden%22%3Atrue%7D%2C%7B%22text%22%3A%22Low%20Fat%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Fat%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Carb%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Carb%22%2C%22hidden%22%3Afalse%7D%2C%7B%22text%22%3A%22Low%20Calorie%22%2C%22description%22%3A%22Nutrition%3A%20Low%20Calorie%22%2C%22hidden%22%3Afalse%7D%5D%2C%22ingredientLines%22%3A%7B%22imperial%22%3A%5B%7B%22ingredient%22%3A%22naan%22%2C%22ingredientId%22%3A%224112436f-3f81-4019-97ca-e886c8fd9641%22%2C%22checked%22%3Afalse%2C%22category%22%3A%22bakery%22%2C%22categoryId%22%3A%22a18ef82c-56c9-4ace-9283-cfe9dcda1731%22%2C%22remainder%22%3A%22%22%2C%22amount%22%3A4%2C%22abbreviation%22%3A%22piece%22%2C%22pluralAbbreviation%22%3A%22pieces%22%2C%22decimal%22%3Afalse%2C%22unit%22%3A%22piece%22%2C%22pluralUnit%22%3A%22pieces%22%7D%2C%7B%22ingredient%22%3A%22extra-virgin%20olive%20oil%22%2C%22ingredientId%22%3A%226ea1b4fd-e6a0-4eec-ae75-2bba261ae482%22%2C%22checked%22%3Afalse%2C%22category%22%3