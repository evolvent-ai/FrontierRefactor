":5}},{"@type":"Review","dateCreated":"2021-01-12","reviewBody":"Fabulous the garlic is so sweet.\nUsed basil olive oil for added flavor","author":{"@type":"Person","name":"LoriOgrain"},"itemReviewed":{"@type":"Thing","name":"Easy Roasted Garlic"},"reviewRating":{"@type":"Rating","bestRating":5,"worstRating":1,"ratingValue":4}}],"cookingMethod":["Roasting"],"keywords":"Sugar Free, Roasting, Low Sugar, Low Saturated Fat, Low Carb, Low Calorie, High Vitamin C","recipeIngredient":["4 heads garlic whole","2 teaspoons extra-virgin olive oil ","1 teaspoon salt "],"recipeInstructions":[{"@type":"HowToStep","text":"Preheat the oven to 400°F.","name":"Step 1: Preheat the oven to…","url":"https://www.yummly.com/recipe/Easy-Roasted-Garlic-9116026","image":"https://lh3.googleusercontent.com/mHLje1Q8afMSL-M1ISPwzwo5Te5_msK3672ICy6NnOrHimH7PJ5bdatmLX5wqMLDjCBENqvkxxVd9695YQhr2Q=w1200-h630-pp-rj-v1-e365","position":1,"author":"Yummly","publisher":{"@type":"Organization","name":"Yummly","logo":{"@type":"ImageObject","url":"https://x.yummlystatic.com/web/yummly.svg"}}},{"@type":"HowToStep","text":"Remove the papery skins from the outside of the garlic heads (do not separate the cloves). Slice the pointed tops from the heads, creating a flat surface exposing the cloves.","name":"Step 2: Remove the papery s…","url":"https://www.yummly.com/recipe/Easy-Roasted-Garlic-9116026","image":"https://lh3.googleusercontent.com/mHLje1Q8afMSL-M1ISPwzwo5Te5_msK3672ICy6NnOrHimH7PJ5bdatmLX5wqMLDjCBENqvkxxVd9695YQhr2Q=w1200-h630-pp-rj-v1-e365","position":2,"author":"Yummly","publisher":{"@type":"Organization","name":"Yummly","logo":{"@type":"ImageObject","url":"https://x.yummlystatic.com/web/yummly.svg"}}},{"@type":"HowToStep","text":"Cut four square sheets of aluminum foil. Place one head of garlic cut side up in the center of each sheet.","name":"Step 3: Cut four square she…","url":"https://www.yummly.com/recipe/Easy-Roasted-Garlic-9116026","image":"https://lh3.googleusercontent.com/mHLje1Q8afMSL-M1